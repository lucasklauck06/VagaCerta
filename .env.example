# Copie para .env (não versionado) e reinicie o `npx expo start`.
# URL do backend pelo IP da máquina na rede Wi-Fi (ver backend/README.md). Vazio = dados de exemplo.
EXPO_PUBLIC_API_URL=
# Supabase: Project Settings → API Keys. Só a chave publishable (anon); NUNCA a secret.
# Usadas só para o Realtime das vagas. Vazias = app funciona sem atualização ao vivo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
